{
  csdr_server: {
    // The hostname or IP address of the csdr_server instance.
    host: "127.0.0.1",
    // The TCP port the server listens on.
    port: 7355,
    // Timeout, in seconds, before attempting to reconnect after connection drops.
    timeout: 10,
    /*
    Audio buffer size in seconds.
    For connections to localhost set this to 0 seconds, for servers hosted over LAN or WAN use 1-2 seconds.
    */
    buffer_seconds: 0,
    /*
    IQ sample format requested from csdr_server.
    "f32" is the default and may give slightly better results.
    "s16" uses about half the network bandwidth, but will use slightly more CPU.
Keep as "f32" unless you're connecting to a csdr_server instance on LAN or WAN.
    */
    iq_format: "f32",
  },

  station: {
    // Frequency in MHz. Valid NOAA Weather Radio range: 162.4 through 162.55.
    frequency: 162.55,
  },

  // Stream to one or more icecast mountpoints
  icecast: {
    // Enable or disable all icecast outputs
    enabled: true,
    // Define one or more Icecast destinations.
    destinations: [
      {
        // Enable or disable this output
        enabled: true,
        // The hostname, IP address, or web URL of the icecast server.
        host: "127.0.0.1",
        // The port the server listens on.
        port: 8000,
        // Enable if the icecast server uses TLS (most don't).
        tls: false,
        // The mountpoint where the stream will be accessible to listeners.
        mount: "/nwr.mp3",
        // The username for authentication to the server.
        username: "source",
        // The password for authentication to the server.
        password: "hackme",
        // Encoding format ("mp3" or "ogg").
        format: "mp3",
        // The audio sample rate to encode at for this icecast mountpoint. Valid values are 8000, 11025, 16000, 22050, 24000, 32000, 44100, and 48000.
        sample_rate: 16000,
        // Encoder bitrate in Kbps for this icecast mountpoint.
        bitrate: 32,
        // The stream name.
        name: "NOAA Weather Radio",
        // The stream genre. This doesn't really matter for NOAA Weather Radio.
        genre: "Weather",
        // The stream description.
        description: "NOAA Weather Radio via rtl_weatherband",
        // Controls whether the stream is public. You most likely want this enabled.
        public: true,
      },
      // Add more destinations here if you want to stream to multiple mounts or servers.
    ],
  },

  // Output the stream to one or more sound cards on your device, great for connecting your machine up to an ENDEC without worrying about icecast instability.
  soundcard: {
    // Enable/disable all soundcard outputs
    enabled: true,
    outputs: [
      {
        // Enable or disable this output
        enabled: false,
        /*
        The sound card to output to.
        Leave unset to use the system default output device.
        ALSA examples: "plughw:1", "plughw:1,0", "hw:1".
        Pulse/PipeWire examples: "pulse:61" or "pulse:alsa_output.example.sink".
        You can also use a sounddevice/PortAudio device index or name.
        */
        // device: "plughw:1,0",
      },
      // Add more sound card outputs here if needed.
    ],
  },

  // Fallback audio will be played when the server goes down so listeners aren't hearing silence.
  fallback: {
    // The time, in seconds, to wait before fallback audio starts playing. Valid range is 30 through 120 seconds.
    silence_timeout_seconds: 30,
    /*
    How long to wait after the fallback audio finishes before starting it again.
    Set to 0 for a continuous loop with no gap. You probably want a few seconds of silence in most cases
    */
    loop_delay_seconds: 5,
    /*
    Optional path to a custom WAV file. Leave unset to use the default.
    Custom files must be mono, WAV, PCM signed 16-bit little-endian, and under 30 seconds.
    */
    // path: "/path/to/fallback.wav",
  },

  // Record EAS/SAME alerts from the same audio sent to Icecast and soundcard outputs.
  eas_recording: {
    // Requires the easrecorder Python package and multimon-ng.
    enabled: false,
    // Seconds of audio to prepend before the decoded SAME header. Valid range: 0 through 10.
    pre_seconds: 2,
    // Seconds of audio to append after EOM. Valid range: 0 through 10.
    post_seconds: 5,
    // Maximum recording length for a single alert, in seconds.
    max_seconds: 120,
    /*
    Directory where alert recordings and index.json will be saved.
    Environment variables are supported here, for example "$STATE_DIRECTORY/alerts".
    Leave unset to use $STATE_DIRECTORY/alerts when systemd provides it,
    then $XDG_STATE_HOME/rtl_weatherband/alerts, or ~/.local/state/rtl_weatherband/alerts.
    */
    // directory: "$STATE_DIRECTORY/alerts",
    // Recording format: "wav" or "mp3".
    format: "wav",
    // Use local time in generated filenames instead of UTC.
    local_time: false,
  },

  audio: {
    // NFM deemphasis filter for reducing high frequency content.
    deemphasis: {
      // Enable or disable this effect
      enabled: true,
      /*
      Time constant in microseconds. Valid range: 0 through 530.
The higher the time constant, the more aggressively the audio will be deemphasized.
Most people should keep this at its default value.
      */
      tau: 300,
    },
    // Controls the stream volume.
    volume: {
      // Enable or disable this effect
      enabled: false,
      // The volume multiplier
      multiplier: 1.0,
    },
    // gets rid of low-frequency audio, such as 60 Hz hums.
    highpass: {
      // Enable or disable this effect
      enabled: false,
      /*
      Frequency in Hz. Frequencies below this value will be attenuated.
      To protect the 1050 Hz attention tone, frequency cannot be set above 900 Hz.
      */
      frequency: 300,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
    // gets rid of high-frequency audio. This is different from the NFM deemphasis filter.
    lowpass: {
      // Enable or disable this effect
      enabled: true,
      /*
      Frequency in Hz. Frequencies above this value will be attenuated.
      To protect SAME tones, frequency cannot be set below 2200 Hz.
      */
      frequency: 3000,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
    // Removes a narrow tone, useful for analog whines.
    notch: {
      // Enable or disable this effect
      enabled: false,
      /*
      Frequency in Hz. Frequencies of and near this value will be attenuated.
      To protect the 1050 Hz attention tone and the SAME tones, the frequency cannot be within protected bands 900-1100, 1400-1600, or 2000-2200 Hz.
      */
      frequency: 3000,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
  },
}
