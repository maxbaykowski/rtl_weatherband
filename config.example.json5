{
  csdr_server: {
    // The hostname or IP address of the csdr_server instance.
    host: "127.0.0.1",
    // The TCP port the server listens on.
    port: 7355,
    // Timeout, in seconds, before attempting to reconnect after connection drops.
    timeout: 10,
    /*
    Audio buffer size in seconds. Use a low value for localhost.
    For remote csdr_server connections, 5-10 seconds can smooth over short network dropouts.
    If the buffer gets low, rtl_weatherband will briefly send silence while it refills.
    This must be lower than fallback.silence_timeout_seconds.
    */
    buffer_seconds: 1,
    /*
    IQ sample format requested from csdr_server.
    "f32" is the default and keeps the most precision.
    "s16" uses about half the network bandwidth; rtl_weatherband converts it back to float internally for DSP.
    */
    iq_format: "f32",
  },

  station: {
    // Frequency in MHz. Valid NOAA Weather Radio range: 162.4 through 162.55.
    frequency: 162.55,
  },

  icecast: {
    // Define one or more Icecast destinations.
    // single-object icecast config is still supported.
    destinations: [
      {
        // The hostname, IP address, or web URL of the icecast server.
        host: "127.0.0.1",
        // The port the server listens on.
        port: 8000,
        // Enable if the icecast server uses TLS.
        tls: false,
        // The mountpoint where the stream will be accessible to listeners.
        mount: "/nwr.mp3",
        // The username for authentication to the server.
        username: "source",
        // The password for authentication to the server.
        password: "hackme",
        // Streaming format ("mp3" or "ogg").
        format: "mp3",
        // The sample rate for the stream. Valid values are 8000, 11025, 16000, 22050, 24000, 32000, 44100, and 48000.
        sample_rate: 16000,
        // Encoder bitrate in Kbps.
        bitrate: 32,
        // The stream name that will appear on the icecast status page.
        name: "NOAA Weather Radio",
        // The genre of the stream. This doesn't really matter for NOAA Weather Radio Streaming.
        genre: "Weather",
        // The stream description that will appear on the icecast status page.
        description: "NOAA Weather Radio via rtl_weatherband",
        // Controls whether the stream is publically available for anyone that connects to the icecast server (you most likely want this enabled).
        public: true,
      },
      // Add more destinations here if you want to stream to multiple mounts or servers.
    ],
  },

  fallback: {
    /*
    If rtl_weatherband has no demodulated audio for this many seconds, it will
    play fallback audio while it keeps trying to reconnect to csdr_server.
    Valid range: 30 through 120 seconds.
    */
    silence_timeout_seconds: 30,
    /*
    How long to wait after the fallback audio finishes before starting it again.
    Set to 0 for a continuous loop with no gap.
    */
    loop_delay_seconds: 0,
    /*
    Optional path to a custom WAV file. Leave unset to use the packaged default.
    Custom files must be mono, WAV, PCM signed 16-bit little-endian, and under 30 seconds.
    */
    // path: "/path/to/fallback.wav",
  },

  audio: {
    // NFM deemphasis filter for reducing high frequency content.
    deemphasis: {
      enabled: true,
      /*
      Time constant in microseconds. Valid range: 0 through 530.
      Please do not disable this filter, doing so will make NFM signals sound awful!
      */
      tau: 300,
    },
    // Controls the stream volume.
    volume: {
      enabled: false,
      multiplier: 1.0,
    },
    /*
    gets rid of low-frequency audio, such as 60 Hz hums.
    To protect the 1050 Hz attention tone, frequency cannot be set above 900 Hz.
    */
    highpass: {
      enabled: false,
      frequency: 300,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
    /*
    gets rid of high-frequency audio. Use it in conjunction with the NFM deemphasis filter.
    To protect SAME tones, frequency cannot be set below 2200 Hz.
    */
    lowpass: {
      enabled: true,
      frequency: 3000,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
    // Removes a narrow tone, useful for analog whines.
    // To protect the 1050 Hz attention tone and the SAME tones, the frequency cannot be within protected bands 900-1100, 1400-1600, or 2000-2200 Hz.
    notch: {
      enabled: false,
      frequency: 3000,
      /* Filter sharpness (0-10).
      0 is more gentle, 10 will cut off frequencies much more aggressively.
      */
      sharpness: 2,
    },
  },
}
